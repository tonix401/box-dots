/* This file is auto-generated by matugen, changes need to be made in the template file in .config/matugen/templates or will be overridden on changing the theme / wallpaper */

* {
    /* Material Design 3 semantic names */
    surface:                        #131318;
    on-surface:                     #e4e1e9;
    on-surface-variant:             #c7c5d0;
    surface-container-high:         #29292f;
    primary:                        #bdc2ff;
    on-primary:                     #252b61;
    secondary:                      #c4c5dd;
    on-secondary:                   #2d2f42;
    secondary-container:            #444559;
    on-secondary-container:         #e0e0f9;
    error:                          #ffb4ab;
    on-error:                       #690005;

    /* Standard rofi color role mappings */
    background:                     #131318;
    foreground:                     #e4e1e9;

    normal-background:              transparent;
    normal-foreground:              #e4e1e9;
    alternate-normal-background:    transparent;
    alternate-normal-foreground:    #c7c5d0;
    selected-normal-background:     #bdc2ff;
    selected-normal-foreground:     #252b61;

    urgent-background:              #29292f;
    urgent-foreground:              #e4e1e9;
    alternate-urgent-background:    #29292f;
    alternate-urgent-foreground:    #e4e1e9;
    selected-urgent-background:     #ffb4ab;
    selected-urgent-foreground:     #690005;

    active-background:              #444559;
    active-foreground:              #e0e0f9;
    alternate-active-background:    #444559;
    alternate-active-foreground:    #e0e0f9;
    selected-active-background:     #c4c5dd;
    selected-active-foreground:     #2d2f42;
}
